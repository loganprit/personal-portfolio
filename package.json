    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.3",
